# PSA Partnership Platform Environment Variables
GEMINI_API_KEY=
# Supabase public keys plus server-only service role key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gmail API OAuth credentials (server only; never use NEXT_PUBLIC_ prefix)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_FROM=
# Portal Relawan remains disabled unless both flags are set to true. Portal Mitra is active.
PORTAL_VOLUNTEER_ENABLED=false
NEXT_PUBLIC_PORTAL_VOLUNTEER_ENABLED=false
