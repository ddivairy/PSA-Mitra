# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Jangan commit .env.local. Semua nilai di bawah ini sengaja dikosongkan.

# URL project Supabase. Aman untuk browser karena memakai prefix NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
# Kunci anon/public Supabase untuk client browser dan alur auth. Aman untuk browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kunci service role Supabase. HANYA untuk server, jangan diberi prefix NEXT_PUBLIC_.
# Dipakai oleh /api/public/directory dan operasi admin atau partner di server.
SUPABASE_SERVICE_ROLE_KEY=

# Flag portal relawan di server. Set true bersama NEXT_PUBLIC_PORTAL_VOLUNTEER_ENABLED.
PORTAL_VOLUNTEER_ENABLED=false
# Flag portal relawan yang dibaca browser. Harus true bersama PORTAL_VOLUNTEER_ENABLED.
NEXT_PUBLIC_PORTAL_VOLUNTEER_ENABLED=false

# ID klien OAuth Gmail untuk email follow-up. Server only, opsional.
GOOGLE_CLIENT_ID=
# Secret klien OAuth Gmail. Server only, opsional.
GOOGLE_CLIENT_SECRET=
# Refresh token OAuth Gmail. Server only, opsional.
GOOGLE_REFRESH_TOKEN=
# Alamat pengirim yang ditampilkan pada email Gmail. Server only, opsional.
GMAIL_FROM=

# Dideklarasikan oleh paket @google/genai, tetapi belum dipakai kode aplikasi saat ini.
GEMINI_API_KEY=
